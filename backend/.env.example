# Local environment file. This file is git-ignored and must never be committed.

# development | production
# When this is "production" the API stops returning stack traces to clients.
NODE_ENV=development

PORT=5000

# MongoDB Atlas connection string (replace with your own cluster URL)
MONGODB_URI=your_mongodb_atlas_connection_string

# Secret used to sign JWTs. Replace with a long random string.
JWT_SECRET=your_secure_secret

# Allowed frontend origin(s), comma separated
CLIENT_URL=http://localhost:5173

# Token lifetime
JWT_EXPIRES_IN=7d

# Used only by "node seed-admin.js" to create the very first admin account.
ADMIN_NAME=RuralCare Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_secure_password
