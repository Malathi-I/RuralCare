{
  "name": "ruralcare",
  "version": "1.0.0",
  "private": true,
  "description": "RuralCare - a scalable rural healthcare platform for rural communities (MERN)",
  "scripts": {
    "install:all": "npm install && npm install --prefix frontend && npm install --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev": "concurrently -n frontend,backend -c cyan,green \"npm:dev:frontend\" \"npm:dev:backend\"",
    "build": "npm run build --prefix frontend",
    "preview": "npm run preview --prefix frontend",
    "start": "npm start --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}